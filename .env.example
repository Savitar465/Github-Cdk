# AWS target environment (optional for environment-agnostic stacks)
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# CDK metadata
CDK_STACK_NAME=KeycloakStack-dev
EKS_CLUSTER_NAME=mini-github-eks

# Network sizing
VPC_MAX_AZS=2
VPC_NAT_GATEWAYS=0

# EKS node group
EKS_NODE_INSTANCE_TYPE=t3.small
EKS_NODE_DESIRED_SIZE=1
EKS_NODE_MIN_SIZE=1
EKS_NODE_MAX_SIZE=1

# Keycloak
KEYCLOAK_HOSTNAME=keycloak-dev.example.com
KEYCLOAK_EXPOSURE=cloudflare-tunnel
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REPLICAS=1

# Cloudflare tunnel (required when KEYCLOAK_EXPOSURE=cloudflare-tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# mkcert TLS material (optional, only used when KEYCLOAK_EXPOSURE=ingress)
# Option A (recommended): point to files in ./tls
MKCERT_TLS_CERT_PATH=./tls/keycloak.savitar.online.pem
MKCERT_TLS_KEY_PATH=./tls/keycloak.savitar.online-key.pem

# Option B: provide base64 directly
# Example: certutil encoded as base64 with no line wraps
MKCERT_TLS_CERT_B64=
MKCERT_TLS_KEY_B64=

# PostgreSQL
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me
RDS_INSTANCE_TYPE=db.t3.micro
RDS_ALLOCATED_STORAGE_GB=20
RDS_ENGINE_VERSION=16.4
RDS_MULTI_AZ=false

