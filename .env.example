# AWS target environment (optional for environment-agnostic stacks)
AWS_ACCOUNT_ID=919968175219
AWS_REGION=us-east-1

# CDK metadata
CDK_STACK_NAME=KeycloakStack-dev
ECS_CLUSTER_NAME=github-ecs

# Network sizing
VPC_MAX_AZS=2
VPC_NAT_GATEWAYS=0

# ECS capacity (EC2-backed cluster)
ECS_INSTANCE_TYPE=t2.micro
ECS_DESIRED_CAPACITY=1
ECS_MIN_CAPACITY=1
ECS_MAX_CAPACITY=1

# Keycloak
KEYCLOAK_HOSTNAME=keycloak-dev.example.com
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REPLICAS=1

# PostgreSQL
DB_NAME=keycloak
DB_PASSWORD=change-me
RDS_INSTANCE_TYPE=t4g.micro
RDS_ALLOCATED_STORAGE_GB=20
RDS_ENGINE_VERSION=16.4
RDS_MULTI_AZ=false

