# =============================================================================
# AWS DEPLOYMENT
# =============================================================================
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# =============================================================================
# CDK STACK
# =============================================================================
CDK_STACK_NAME=Github-cdk
ECS_CLUSTER_NAME=github-ecs

# =============================================================================
# NETWORK
# =============================================================================
VPC_MAX_AZS=2
# Set to 0 to avoid NAT gateway costs (tasks go to public subnets)
VPC_NAT_GATEWAYS=0

# =============================================================================
# KEYCLOAK
# =============================================================================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin-pass
KEYCLOAK_REPLICAS=1
# Optional: custom public hostname (bare hostname, no scheme/path/port)
# KEYCLOAK_HOSTNAME=auth.example.com

# =============================================================================
# POSTGRESQL (RDS)
# =============================================================================
KEYCLOAK_DB_NAME=keycloak
USERS_DB_NAME=ms-users
FILES_DB_NAME=github_files_db
PR_DB_NAME=github_pull_requests
ORG_DB_NAME=github_organizations
DB_PASSWORD=change-me-db-pass

RDS_INSTANCE_TYPE=t4g.micro
RDS_ALLOCATED_STORAGE_GB=20
RDS_ENGINE_VERSION=17.2
RDS_PUBLICLY_ACCESSIBLE=true
RDS_MULTI_AZ=false

# =============================================================================
# MONGODB (self-managed on ECS — reachable at mongodb.github.local:27017)
# =============================================================================
MONGODB_USERNAME=mongoadmin
MONGODB_PASSWORD=change-me-mongo-pass

# =============================================================================
# USERS MICROSERVICE
# =============================================================================
SERVER_PORT=8081
SPRING_APPLICATION_NAME=users-ms

KEYCLOAK_ISSUER_URI=http://<keycloak-alb-dns>/realms/Github
KEYCLOAK_JWK_SET_URI=http://<keycloak-alb-dns>/realms/Github/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=ms-users
KEYCLOAK_CLIENT_SECRET=change-me-client-secret
KEYCLOAK_AUTH_GRANT_TYPE=client_credentials
KEYCLOAK_SCOPE=openid

KEYCLOAK_SERVER_URL=http://<keycloak-alb-dns>
KEYCLOAK_REALM=Github
KEYCLOAK_ADMIN_CLIENT=admin-client-java
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-admin-client-secret

# =============================================================================
# REPOSITORY MICROSERVICE
# =============================================================================
REPO_MONGO_HOST=mongodb.github.local
REPO_MONGO_PORT=27017
REPO_MONGO_DATABASE=github_repository_ms
REPO_MONGO_USERNAME=mongoadmin
REPO_MONGO_PASSWORD=change-me-mongo-pass
REPO_MONGO_AUTH_DATABASE=admin

REPO_SERVER_PORT=8090

REPO_GIT_SERVER_HTTP_URL=http://git-server.github.local:9080
REPO_GIT_SERVER_SSH_HOST=git-server.github.local
REPO_GIT_SERVER_SSH_PORT=2222

REPO_MICROSERVICE_AUTH_TOKEN=change-me-long-random-secret-32chars

REPO_JWT_ISSUER_URI=http://<keycloak-alb-dns>/realms/Github
REPO_JWT_JWK_SET_URI=http://<keycloak-alb-dns>/realms/Github/protocol/openid-connect/certs

REPO_KEYCLOAK_HOST=http://<keycloak-alb-dns>
REPO_KEYCLOAK_PORT=
REPO_KEYCLOAK_REALM=Github

# =============================================================================
# GIT SERVER
# =============================================================================
# URL the git-auth SSH hook uses to check repo permissions
SERVER_MICROSERVICE_URL=http://repository-ms.github.local:8090
# Shared secret between git-server and the repository microservice
SERVER_MICROSERVICE_AUTH_TOKEN=change-me-long-random-secret-32chars

# =============================================================================
# FILES MICROSERVICE
# =============================================================================
FILES_SERVER_PORT=8083
FILES_DB_PORT=5432
FILES_DB_USERNAME=postgres
FILES_DB_PASSWORD=change-me-db-pass
FILES_JWT_ISSUER_URI=http://<keycloak-alb-dns>/realms/Github
FILES_APP_SECURITY_OAUTH2_ENABLED=false

# =============================================================================
# PULL-REQUEST MICROSERVICE
# =============================================================================
PR_SERVER_PORT=8084
PR_SPRING_PROFILES_ACTIVE=aws
PR_DB_PORT=5432
PR_DB_USERNAME=postgres
PR_DB_PASSWORD=change-me-db-pass
PR_JWT_ISSUER_URI=http://<keycloak-alb-dns>/realms/Github
PR_APP_SECURITY_OAUTH2_ENABLED=false

# =============================================================================
# ORGANIZATIONS MICROSERVICE
# =============================================================================
ORG_SERVER_PORT=8085
ORG_DB_PORT=5432
ORG_DB_USERNAME=postgres
ORG_DB_PASSWORD=change-me-db-pass
ORG_SSL_CERT_PATH=./global-bundle.pem
ORG_JWT_ISSUER_URI=http://<keycloak-alb-dns>/realms/Github
ORG_JWT_JWK_SET_URI=http://<keycloak-alb-dns>/realms/Github/protocol/openid-connect/certs

# =============================================================================
# FRONTEND (Next.js)
# NOTE: NEXT_PUBLIC_KEYCLOAK_URL is derived automatically from the Keycloak
# ALB at synth time — no need to set it here.
# =============================================================================
NEXT_PUBLIC_FILES_API_URL=http://files-ms.github.local:8083/api
NEXT_PUBLIC_USERS_API_URL=http://users.github.local:8081
NEXT_PUBLIC_REPOSITORY_API_URL=http://repository-ms.github.local:8090
NEXT_PUBLIC_PR_API_URL=http://pullrequest-ms.github.local:8084/api
NEXT_PUBLIC_ORG_API_URL=http://organization-ms.github.local:8085
NEXT_PUBLIC_ISSUES_API_URL=http://localhost:8091

NEXT_PUBLIC_KEYCLOAK_REALM=Github
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ms-users
NEXT_PUBLIC_USE_KEYCLOAK=false
NEXT_PUBLIC_USE_MOCK_AUTH=false

NEXT_PUBLIC_GIT_HTTP_URL=http://repository-ms.github.local:8090
NEXT_PUBLIC_GIT_SSH_HOST=repository-ms.github.local
NEXT_PUBLIC_GIT_SSH_PORT=2222
