# AWS target environment (optional for environment-agnostic stacks)
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# CDK metadata
CDK_STACK_NAME=KeycloakStack-dev
EKS_CLUSTER_NAME=keycloak-cluster

# Network sizing
VPC_MAX_AZS=2
VPC_NAT_GATEWAYS=1

# Keycloak
KEYCLOAK_HOSTNAME=keycloak-dev.example.com
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REPLICAS=1

# PostgreSQL
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me
RDS_MULTI_AZ=false

