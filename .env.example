# AWS target environment (optional for environment-agnostic stacks)
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
ALLOWED_SSH_CIDR=0.0.0.0/0
EC2_KEY_NAME=

# CDK metadata
CDK_STACK_NAME=KeycloakStack-dev
EKS_CLUSTER_NAME=mini-github-eks

# Network sizing
VPC_MAX_AZS=2
VPC_NAT_GATEWAYS=0

# EKS node group
EKS_NODE_INSTANCE_TYPE=t3.small
EKS_NODE_DESIRED_SIZE=1
EKS_NODE_MIN_SIZE=1
EKS_NODE_MAX_SIZE=1

# Keycloak
KEYCLOAK_HOSTNAME=keycloak-dev.example.com
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REPLICAS=1

# PostgreSQL
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me
RDS_INSTANCE_TYPE=db.t3.micro
RDS_ALLOCATED_STORAGE_GB=20
RDS_ENGINE_VERSION=16.4
RDS_MULTI_AZ=false

