{
  "info": {
    "name": "Github Repositories API",
    "description": "Postman collection for API Gateway + Lambda + DynamoDB repository CRUD endpoints.\n\nUsage flow:\n1) Set {{baseUrl}} to your deployed ApiUrl including /v1\n2) Run Health\n3) Run Create Repository (with profile image)\n4) Run Get/List/Update/Delete by id\n\nImportant: when an image object is deleted from S3, a separate Lambda removes its DynamoDB repository item automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/v1",
      "type": "string"
    },
    {
      "key": "repositoryId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health - GET /health",
      "description": "Checks if the API is alive.",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Create Repository - POST /repositories",
      "description": "Creates a repository and optionally uploads a profile image to S3 using profileImageBase64 + profileImageContentType.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"mini-github-api\",\n  \"owner\": \"savitar\",\n  \"description\": \"Repository created from Postman\",\n  \"visibility\": \"public\",\n  \"defaultBranch\": \"main\",\n  \"topics\": [\"aws\", \"cdk\", \"lambda\"],\n  \"archived\": false,\n  \"profileImageContentType\": \"image/png\",\n  \"profileImageBase64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADElEQVQIW2P8/5+hHgAGgwJ/lwJ6WQAAAABJRU5ErkJggg==\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/repositories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repositories"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
                "pm.test('Response has repository id', function () {",
                "  const data = pm.response.json();",
                "  pm.expect(data.id).to.be.a('string').and.not.empty;",
                "});",
              "",
              "const data = pm.response.json();",
              "if (data && data.id) {",
              "  pm.collectionVariables.set('repositoryId', data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List Repositories - GET /repositories",
      "description": "Returns all repositories stored in DynamoDB.",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/repositories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repositories"
          ]
        }
      }
    },
    {
      "name": "Get Repository By ID - GET /repositories/{id}",
      "description": "Fetches one repository by id. Requires {{repositoryId}}.",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/repositories/{{repositoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repositories",
            "{{repositoryId}}"
          ]
        }
      }
    },
    {
      "name": "Update Repository - PUT /repositories/{id}",
      "description": "Partially updates repository metadata fields (description, visibility, metrics, topics, etc.). Requires {{repositoryId}}.",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated from Postman\",\n  \"visibility\": \"private\",\n  \"topics\": [\"aws\", \"api-gateway\"],\n  \"stars\": 10,\n  \"forks\": 2,\n  \"openIssues\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/repositories/{{repositoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repositories",
            "{{repositoryId}}"
          ]
        }
      }
    },
    {
      "name": "Delete Repository - DELETE /repositories/{id}",
      "description": "Deletes repository item from DynamoDB by id. Requires {{repositoryId}}.",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/repositories/{{repositoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repositories",
            "{{repositoryId}}"
          ]
        }
      }
    },
    {
      "name": "Cleanup Behavior Note",
      "description": "There is no REST endpoint to delete S3 objects directly. To test automatic cleanup Lambda:\n1) Create repository with profile image\n2) Delete the object key profileImageKey in S3 (console/CLI)\n3) Call GET /repositories/{id} and expect 404 because cleanup Lambda deletes DynamoDB item.",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/repositories/{{repositoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repositories",
            "{{repositoryId}}"
          ]
        }
      }
    }
  ]
}

