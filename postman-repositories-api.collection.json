{
  "info": {
    "name": "Github Repositories API",
    "description": "Postman collection for API Gateway + Lambda + DynamoDB repository CRUD endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/v1",
      "type": "string"
    },
    {
      "key": "repositoryId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health - GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Create Repository - POST /repositories",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"mini-github-api\",\n  \"owner\": \"savitar\",\n  \"description\": \"Repository created from Postman\",\n  \"visibility\": \"public\",\n  \"defaultBranch\": \"main\",\n  \"topics\": [\"aws\", \"cdk\", \"lambda\"],\n  \"archived\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/repositories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repositories"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const data = pm.response.json();",
              "if (data && data.id) {",
              "  pm.collectionVariables.set('repositoryId', data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List Repositories - GET /repositories",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/repositories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repositories"
          ]
        }
      }
    },
    {
      "name": "Get Repository By ID - GET /repositories/{id}",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/repositories/{{repositoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repositories",
            "{{repositoryId}}"
          ]
        }
      }
    },
    {
      "name": "Update Repository - PUT /repositories/{id}",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated from Postman\",\n  \"visibility\": \"private\",\n  \"topics\": [\"aws\", \"api-gateway\"],\n  \"stars\": 10,\n  \"forks\": 2,\n  \"openIssues\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/repositories/{{repositoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repositories",
            "{{repositoryId}}"
          ]
        }
      }
    },
    {
      "name": "Delete Repository - DELETE /repositories/{id}",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/repositories/{{repositoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "repositories",
            "{{repositoryId}}"
          ]
        }
      }
    }
  ]
}

